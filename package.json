{
  "name": "cloudbudget-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev:api": "npm run dev -w @cloudbudget/api",
    "dev:web": "npm run dev -w @cloudbudget/web",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "db:migrate": "npm run db:migrate -w @cloudbudget/api",
    "db:seed": "npm run db:seed -w @cloudbudget/api",
    "build:shared": "npm run build -w @cloudbudget/shared",
    "build:api": "npm run build:shared && npm run build -w @cloudbudget/api",
    "build:web": "npm run build:shared && npm run generate -w @cloudbudget/web",
    "lint": "node --check scripts/smoke.mjs",
    "test": "npm run build:shared && npm run test -w @cloudbudget/api",
    "typecheck": "npm run build:api && npm run typecheck -w @cloudbudget/web",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}

